<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- ASP ランタイムエラーをブラウザに直接送信しない（文字化け防止） -->
        <asp scriptErrorSentToBrowser="false" />

        <!-- 500 エラーをカスタムページにリダイレクト -->
        <httpErrors errorMode="Custom" existingResponse="Replace">
            <remove statusCode="500" subStatusCode="-1" />
            <error statusCode="500" subStatusCode="-1"
                   path="/iraikanri/error500.asp"
                   responseMode="ExecuteURL" />
        </httpErrors>
    </system.webServer>
</configuration>
